# Google Sheets lead logging (required)
# 1. Create a Google Cloud service account with the "Google Sheets API" enabled
# 2. Share your Google Sheet with the service account's email (Editor access)
# 3. Fill these in (on Vercel: Project Settings -> Environment Variables)
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
GOOGLE_SHEET_ID=your-google-sheet-id
